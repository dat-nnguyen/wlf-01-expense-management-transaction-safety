# Application Environment (development | testing | production)
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
DEBUG=True

# Database Configuration (PostgreSQL in prod/docker, SQLite for local zero-config fallback)
DATABASE_URL=sqlite:///./wealify_guardian.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wealify_guardian

# AI / LLM Configuration
# Options: mock | openai | gemini | claude
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GEMINI_API_KEY=

# Connector Modes (mock | readonly | verified_user_only)
WEALIFY_MODE=mock
EMAIL_MODE=mock

# Security & Policy
POLICY_STRICT_READONLY=true
MAX_ALERT_DEADLINE_DAYS=60
