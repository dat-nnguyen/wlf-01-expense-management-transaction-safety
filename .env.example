# ============================================================
# WEALIFY GUARDIAN — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ============================================================

# Application Environment
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
DEBUG=True

# ------------------------------------------------------------
# 1. LLM PROVIDER CONFIGURATION
# ------------------------------------------------------------
# Options for LLM_PROVIDER:
#   - openrouter: Multi-model router (OpenAI, Claude, DeepSeek R1, Llama 3, Gemini)
#   - openai    : OpenAI Direct (GPT-4o, GPT-4o-mini, o1, o3-mini)
#   - gemini    : Google Gemini Direct (gemini-1.5-flash, gemini-2.0-flash)
#   - claude    : Anthropic Claude Direct (claude-3-5-sonnet-20241022)
#   - groq      : Groq ultra-fast (llama-3.3-70b-versatile, deepseek-r1-distill-llama-70b)
#   - deepseek  : DeepSeek Direct (deepseek-chat, deepseek-reasoner)
#   - ollama    : Local offline (llama3, qwen2.5)
#   - mock      : Deterministic offline mode (zero API key needed)

LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini

# --- OpenRouter Configuration (Recommended: 1 Key for 200+ Models) ---
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
# Popular OpenRouter models:
#   openai/gpt-4o-mini
#   anthropic/claude-3.5-sonnet
#   deepseek/deepseek-r1
#   deepseek/deepseek-chat
#   google/gemini-2.0-flash-exp:free
#   meta-llama/llama-3.3-70b-instruct

# --- Direct Provider Keys (Optional if using OpenRouter) ---
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------
DATABASE_URL=sqlite:///./wealify_guardian.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wealify_guardian

# ------------------------------------------------------------
# 3. CONNECTORS & DATA SOURCE MODES
# ------------------------------------------------------------
WEALIFY_MODE=mock
EMAIL_MODE=mock

# ------------------------------------------------------------
# 4. STRICT FINANCIAL SAFETY & POLICY BOUNDARIES
# ------------------------------------------------------------
POLICY_STRICT_READONLY=true
MAX_ALERT_DEADLINE_DAYS=60

# ------------------------------------------------------------
# 5. SMTP EMAIL CONFIGURATION (Real Live Email Delivery)
# ------------------------------------------------------------
# For Gmail (Use App Password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your_email@gmail.com
#   SMTP_PASSWORD=your_16_character_google_app_password
#   SMTP_USE_SSL=false
#

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME="Wealify Guardian Copilot"
SMTP_USE_SSL=false
